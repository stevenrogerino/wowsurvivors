+  /** A scheduled boss's late growth (Config.bossLateFrom): 1 until then. */
+  Wave.bossLate = function (time) {
+    const cfg = WS.Config;
+    return 1 + WS.max(0, time - (cfg.bossLateFrom || 0)) / (cfg.bossLateTime || Infinity);
+  };
+
